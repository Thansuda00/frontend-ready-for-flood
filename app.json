{
  "expo": {
    "name": "ReadyForFlood",
    "slug": "ReadyForFlood",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-profile.png",
    "scheme": "readyforflood",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.readyforflood.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.readyforflood.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-profile.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-profile.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6fd9289b-c2fe-4420-afdf-1ed329fc50e3"
      }
    }
  }
}
